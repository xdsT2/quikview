// QuikView Windows resource script -- only job: embed the app icon into the PE.
//
// Why embedded: Explorer / taskbar pin / file associations / shortcut default
// icons all read RT_GROUP_ICON from the exe. Before this file existed the repo
// had no .rc at all, so ExtractIconW returned 0 and every shortcut was blank.
//
// windres resolves the ICON path relative to its working directory, which is not
// necessarily resources/, so CMakeLists passes --include-dir=<src>/resources.
// (Keep this file ASCII-only: windres is picky about encodings.)

IDI_ICON1 ICON "quikview.ico"

// PE version resource. Without it Explorer's "Details" tab is empty and
// `(Get-Item quikview.exe).VersionInfo.FileVersion` returns "" -- which makes
// "did the installer ship the right build?" impossible to verify.
// qv_version.h is generated by CMake from project(VERSION ...): the single
// source of truth. Never hardcode a version number here.
#include "qv_version.h"

// windres 不会自动加载 windows.h，这几个枚举自己写，避免依赖头文件搜索路径
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP          0x00000001L
#define VFT2_UNKNOWN     0x00000000L

1 VERSIONINFO
FILEVERSION    QV_VER_MAJOR,QV_VER_MINOR,QV_VER_PATCH,QV_VER_BUILD
PRODUCTVERSION QV_VER_MAJOR,QV_VER_MINOR,QV_VER_PATCH,QV_VER_BUILD
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "QuikView Project"
            VALUE "FileDescription",  "QuikView Image Viewer"
            VALUE "FileVersion",      QV_VERSION_STR
            VALUE "InternalName",     "quikview"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "quikview.exe"
            VALUE "ProductName",      "QuikView"
            VALUE "ProductVersion",   QV_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
